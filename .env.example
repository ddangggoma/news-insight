# Development defaults. Copy to .env and replace secrets before any shared deployment.
# POSTGRES_PASSWORD is embedded in DATABASE_URL: use URL-safe characters only.
APP_ENV=development
POSTGRES_DB=news_insight
POSTGRES_USER=news
POSTGRES_PASSWORD=news-dev-password
PUBLIC_HOST=localhost
# Host ports (docs/PORTS.md). Use 443/80 only for a public-domain deployment.
# The edge proxy (scripts/install-edge-proxy.sh) listens on CADDY_HTTPS_PORT / CADDY_HTTP_PORT
# and relays to Caddy, which Docker publishes on 127.0.0.1 at the CADDY_LOCAL_* ports.
CADDY_HTTPS_PORT=8700
CADDY_HTTP_PORT=8701
CADDY_LOCAL_HTTPS_PORT=8702
CADDY_LOCAL_HTTP_PORT=8703
ADMIN_EMAIL=ddangggoma@gmail.com
LM_STUDIO_URL=http://host.docker.internal:1234
LM_STUDIO_MODEL=qwen/qwen3.8-27b
# Source credentials (roadmap D11): the catalog references them by name
# (config.auth.secret: GITHUB_TOKEN) and the value is read from SOURCE_SECRET_<NAME>.
# Local CLI runs: `uv run --env-file ../../.env news-insight ...`. Never commit real values.
SOURCE_SECRET_GITHUB_TOKEN=
# Official API alternatives (Phase 3.7): YouTube Data API v3 key, Naver Search API app id/secret.
SOURCE_SECRET_YOUTUBE_API_KEY=
SOURCE_SECRET_NAVER_CLIENT_ID=
SOURCE_SECRET_NAVER_CLIENT_SECRET=
# EPO Open Patent Services consumer key/secret (developers.epo.org, free): patent publications (plan 16 #5)
SOURCE_SECRET_EPO_OPS_KEY=
SOURCE_SECRET_EPO_OPS_SECRET=

# Operations console (roadmap D16). The web server calls /api/admin with this key.
CONSOLE_API_KEY=dev-console-key-change-me
# Reader web (R4): the web server calls /api/public with this key. Empty = reader API off.
PUBLIC_API_KEY=dev-public-key-change-me
# Site login (plan 14): username and password, sign-ups approved by an admin in /console/users.
# Create the first admin with `scripts/dev.sh create-admin`. ADMIN_EMAIL gets a mail for each new
# sign-up (needs SMTP); PUBLIC_BASE_URL is the console link in that mail. Operational alerts stay
# on the console; OPS_ALERT_MAIL=true would mail new critical/warning alerts too.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>, SMTP_PASSWORD=<app password>.
PUBLIC_BASE_URL=https://localhost:8700
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Daily digest (roadmap D14): host-side Claude CLI, run by launchd at 05:00 KST.
CLAUDE_CLI=claude
DIGEST_MODEL=opus
# Korean cards (roadmap D18): host-side Antigravity CLI, kept above a 10 % weekly reserve, with
# Claude Code (Haiku) lanes alongside outside CARD_CLAUDE_QUIET_HOURS and below
# CARD_CLAUDE_DAILY_CAP (2026-10-13). Codex and local Qwen are off for cards unless switched on.
# launchd has no nvm on PATH: point CODEX_CLI at the native binary under
# …/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex
CODEX_CLI=codex
CARD_CODEX_ENABLED=false
AGY_CLI=agy
CARD_AGY_MODEL=gemini-3.8-flash-low
CARD_AGY_MIN_WEEKLY=10
CARD_CLAUDE=true
CARD_CLAUDE_MODEL=claude-haiku-5-5
CARD_QWEN_FALLBACK=false

# OpenAlex polite pool: a contact address raises the free rate limit (not committed anywhere)
OPENALEX_MAILTO=
# Free OpenAlex key (openalex.org/settings/api): 10x the daily budget; sent as a Bearer header
OPENALEX_API_KEY=
