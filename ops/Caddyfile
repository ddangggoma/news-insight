{
	# Caddy listens on the same ports inside the container (docs/PORTS.md).
	https_port {$CADDY_HTTPS_PORT:8700}
	http_port {$CADDY_HTTP_PORT:8701}
	# Clients connecting to a literal IP may omit TLS SNI. Use the configured
	# host as the certificate fallback so IP-based HTTPS still works.
	default_sni {$PUBLIC_HOST:localhost}
	# Built-in redirects drop the port when it equals https_port, so we redirect
	# explicitly below. Certificate automation stays enabled.
	auto_https disable_redirects
	order rate_limit before handle
	# Visitor addresses (2026-10-17, docs/runbooks/operations.md §13). Docker Desktop's port
	# publishing hides them: every connection used to arrive from the VM gateway (192.168.65.1).
	# The edge proxy on the Mac (ops/edge/proxy.py) now owns the public ports and relays to
	# Caddy's loopback-only ports, starting each connection with a PROXY protocol header that
	# carries the visitor's address. Headers are used only from CADDY_PROXY_FROM, the network
	# gateway those loopback connections come from (ops/caddy/start.sh); from anywhere else they
	# are ignored. {remote_host}, the rate-limit keys and X-Forwarded-For are then the visitor.
	servers {
		listener_wrappers {
			proxy_protocol {
				allow {$CADDY_PROXY_FROM:127.0.0.1/32}
			}
			tls
		}
	}
}

(site) {
	encode zstd gzip

	# The console API is internal: only the web server calls it, over the compose network.
	@admin_api path /api/admin /api/admin/*
	handle @admin_api {
		respond 404
	}

	# The reader API (R4) is internal too: the web server renders public pages from it.
	@public_api path /api/public /api/public/*
	handle @public_api {
		respond 404
	}

	# Web-internal hooks (cache revalidation after a deploy) are reached over the compose network only.
	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	# Every page needs a login: the web server checks the session on each request (plan 14).

	# Request limits (checklist OPS-2). Until the edge proxy (2026-10-17, see the top) every
	# request arrived from the Docker VM gateway, so a per-IP key was one budget for the whole
	# site and one busy page load locked everyone out with 429 (2026-10-12). Every page needs a
	# login, so pages and the radar are counted per address and session cookie; `site` caps one
	# address, including anyone who rotates cookies. The radar aggregates the corpus on a cache
	# miss, so it gets a tighter budget. Static assets are free.
	@limited not path /_next/static/* /favicon.ico /icon.svg
	rate_limit @limited {
		zone radar {
			match {
				path /radar /radar/*
			}
			key {remote_host}:{http.request.cookie.ni_session}
			events {$RATE_LIMIT_RADAR:60}
			window 1m
		}
		zone pages {
			key {remote_host}:{http.request.cookie.ni_session}
			events {$RATE_LIMIT_PAGES:300}
			window 1m
		}
		zone site {
			key {remote_host}
			events {$RATE_LIMIT_SITE:1500}
			window 1m
		}
		# Login and sign-up form posts (plan 14); the API also locks accounts and throttles failures
		zone auth {
			match {
				path /login /signup
			}
			key {remote_host}
			events {$RATE_LIMIT_AUTH:30}
			window 1m
		}
	}

	# A refused or failed request used to show an empty page. Pages get a short notice that
	# reloads itself; /api and Next.js data requests (RSC header) keep a plain status so their
	# callers can handle it.
	handle_errors 429 502 503 504 {
		@data `path('/api/*') || header({'RSC': '1'})`
		handle @data {
			respond `{"detail":"지금은 요청을 처리할 수 없습니다. 잠시 후 다시 시도하세요."}` {err.status_code}
		}
		handle {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control no-store
			respond <<HTML
				<!doctype html>
				<html lang="ko">
				<head>
				<meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta http-equiv="refresh" content="15">
				<title>잠시 후 다시 시도합니다</title>
				<style>
				body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui,sans-serif;background:#fafafa;color:#18181b}
				@media (prefers-color-scheme:dark){body{background:#09090b;color:#fafafa}}
				main{max-width:28rem;padding:1.5rem;text-align:center}
				p{color:#71717a;font-size:.9rem;line-height:1.6}
				a{color:inherit}
				</style>
				</head>
				<body>
				<main>
				<h1>잠시 후 다시 연결합니다</h1>
				<p>요청이 몰렸거나 서버가 다시 시작하는 중입니다. 15초 뒤 이 페이지를 자동으로 다시 엽니다. 새로고침을 반복하면 기다리는 시간이 길어집니다.</p>
				<p><a href="">지금 다시 시도</a></p>
				</main>
				</body>
				</html>
				HTML {err.status_code}
		}
	}

	# A written trend report (plan 17 R1) opens inside the site's own frame on /reports/{id}:
	# that page alone may be framed by this origin. Its HTML has no scripts and no outside
	# resources; the report CSP matches the one the web route sets.
	@framed_report path_regexp framed_report ^/reports/[0-9]+/view$
	header @framed_report {
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Next.js hydration and next-themes use inline scripts/styles; everything else is same-origin.
	@site_pages not path_regexp site_pages ^/reports/[0-9]+/view$
	header @site_pages {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Cross-Origin-Opener-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# No HSTS: the site is also served over plain HTTP on the HTTP port (2026-10-06,
	# user decision), and HSTS would make browsers refuse that.

	handle /api/* {
		reverse_proxy api:8000
	}

	# Spoken briefings rendered on the host (plan 13 A1). file_server answers range requests,
	# which Safari and podcast apps need to seek. Only .m4a files, no listings.
	@audio path_regexp audio ^/media/briefings/[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]+\.m4a$
	handle @audio {
		# Caddy serves these itself, so ask the web server whether the visitor is logged in (plan 14)
		forward_auth web:3000 {
			uri /internal/session-check
		}
		root * /srv
		header Cache-Control "private, max-age=86400"
		file_server
	}
	handle /media/* {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}
}

# HTTPS on CADDY_HTTPS_PORT and plain HTTP on CADDY_HTTP_PORT serve the same site
# (2026-10-06: HTTP access was requested; the HTTP port used to redirect to HTTPS).
{$PUBLIC_HOST:localhost} {
	import site
}

http://{$PUBLIC_HOST:localhost} {
	import site
}
