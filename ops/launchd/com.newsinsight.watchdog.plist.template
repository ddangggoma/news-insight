<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.newsinsight.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/ops/watchdog/watchdog.py</string>
    <string>--root</string>
    <string>__REPO__</string>
  </array>
  <!-- at login too: after a reboot this is what starts Docker Desktop again -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/ops/logs/watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/ops/logs/watchdog.log</string>
</dict>
</plist>
