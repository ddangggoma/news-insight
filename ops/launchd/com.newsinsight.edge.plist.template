<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.newsinsight.edge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/ops/edge/proxy.py</string>
    <string>__HTTPS_PORT__=127.0.0.1:__LOCAL_HTTPS_PORT__</string>
    <string>__HTTP_PORT__=127.0.0.1:__LOCAL_HTTP_PORT__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__REPO__/ops/logs/edge.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/ops/logs/edge.log</string>
</dict>
</plist>
