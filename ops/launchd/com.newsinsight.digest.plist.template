<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.newsinsight.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__REPO__" &amp;&amp; scripts/dev.sh digest</string>
  </array>
  <!-- 05:00 publishes; 06:00, 07:00, 08:00 and 10:00 retry only while the date has no published
       briefing (08:00 and 10:00 added 2026-10-06: a Claude session limit blocked all three
       morning tries on 2026-10-05) -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>CLAUDE_CLI</key>
    <string>__CLAUDE__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/ops/logs/digest.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/ops/logs/digest.log</string>
</dict>
</plist>
